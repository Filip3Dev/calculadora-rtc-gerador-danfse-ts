{
  "name": "danfse-core",
  "version": "0.1.4",
  "description": "Geração de DANFSe (PDF) a partir do XML da NFS-e Nacional. Porte TS do serviço oficial em Go da Receita Federal, com CLI. Paridade visual verificada contra o oficial.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "^5.0.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "pdfjs-dist": "^4.0.0"
  },
  "keywords": [
    "danfse",
    "nfse",
    "nfs-e",
    "pdf",
    "reforma-tributaria",
    "receita-federal",
    "fiscal",
    "tributos",
    "imposto"
  ],
  "bin": {
    "danfse": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Filip3Dev/calculadora-rtc-gerador-danfse-ts.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Filip3Dev/calculadora-rtc-gerador-danfse-ts#readme",
  "bugs": {
    "url": "https://github.com/Filip3Dev/calculadora-rtc-gerador-danfse-ts/issues"
  },
  "author": "Filip3Dev",
  "engines": {
    "node": ">=22"
  }
}
